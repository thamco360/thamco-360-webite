# Copy this file to .env for local development with `vercel dev`.
# In production, set these as Environment Variables in the Vercel
# project dashboard (or via `vercel env add`) — never commit real
# values to git.

# The Gmail account /api/contact.js sends enquiries through.
GMAIL_USER=thamco360@gmail.com

# A Gmail App Password (not the account password):
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=
